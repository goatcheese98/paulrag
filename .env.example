# ── Backend (Railway) ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# YouTube channel to ingest (default used if not set)
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@LevelUpMortgages

# Comma-separated allowed frontend origins for CORS.
# In Railway, set this to your Cloudflare Pages URL:
# ALLOWED_ORIGINS=https://paulrag.pages.dev
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5176

# Path where ChromaDB stores its data.
# On Railway, set this to your mounted volume path: /data/chroma_db
# Leave unset locally — defaults to backend/chroma_db/
# CHROMA_PATH=/data/chroma_db

# ── Frontend (Cloudflare Pages) ───────────────────────────────────────────────
# Set this in the Cloudflare Pages dashboard → Settings → Environment variables
# Leave unset locally — Vite proxy handles it
# VITE_API_BASE_URL=https://your-app.up.railway.app
